{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.packablock.com/schemas/chain-block.v1.json",
  "title": "Packablock Continuous Attestation Chain Block Schema v1",
  "description": "Validates both the Continuous Attestation Specification v1 ($manifest-chain-link) and official packablock-client ($yaml-chain-meta) validation blocks and semantic diff content blocks.",
  "type": "object",
  "oneOf": [
    {
      "required": ["$manifest-chain-link"],
      "properties": {
        "$manifest-chain-link": { "$ref": "#/$defs/validationBlock" }
      }
    },
    {
      "required": ["$yaml-chain-meta"],
      "properties": {
        "$yaml-chain-meta": { "$ref": "#/$defs/validationBlock" }
      }
    }
  ],
  "$defs": {
    "validationBlock": {
      "type": "object",
      "required": [
        "version",
        "block_index",
        "timestamp",
        "hashing_strategy",
        "data_hash",
        "prev_meta_hash",
        "meta_hash"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "block_index": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "hashing_strategy": {
          "type": "string",
          "enum": ["raw", "semantic"]
        },
        "data_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prev_meta_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "meta_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parent_block_cid": {
          "type": "string"
        },
        "block_cid": {
          "type": "string"
        },
        "layer_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "signature_auth": {
          "type": "object",
          "required": [
            "provider",
            "signer_identity",
            "git_signature"
          ],
          "properties": {
            "provider": { "type": "string" },
            "signer_identity": { "type": "string" },
            "did": {
              "type": "string",
              "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
            },
            "commit": { "type": "string" },
            "git_signature": { "type": "string" }
          }
        }
      }
    }
  }
}
